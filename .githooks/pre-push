#!/bin/sh
# Coverage gate: refuses the push unless every project still enforces 100%
# coverage AND every project's tests reach it. Installed by `pnpm install`
# (scripts/install-git-hooks.js sets core.hooksPath to .githooks).
# Nx caches test results, so unchanged projects are not re-run.
# CI runs the same two checks, so `git push --no-verify` only defers the failure.
set -e

# Pushing from a worktree, git exports GIT_DIR to this hook. Left in place, it
# would redirect every `git -C <fixture>` call the test suites make to this
# checkout (config, commits, even pushes to origin), so drop the variables that
# locate a repository before running anything.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_NAMESPACE

echo "pre-push: checking that every project enforces a 100% coverage gate..."
node scripts/check-coverage-gates.js

echo "pre-push: running every project's tests (100% coverage required)..."
pnpm exec nx run-many -t test --output-style=static
