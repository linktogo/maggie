{
  "name": "@maggie/board",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@linktogo/maggie-ci-status": "^1.3.1",
    "@linktogo/maggie-config": "^1.3.1",
    "@linktogo/maggie-retro-doc": "^1.3.1",
    "@linktogo/maggie-workspace-bootstrap": "^1.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "~5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "~5.1.0"
  },
  "nx": {
    "tags": [
      "scope:board",
      "type:app"
    ],
    "targets": {
      "start": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/board/server.js --config-repo https://github.com/linktogo-org/lk-config.git"
        }
      },
      "test-server": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test --experimental-test-coverage --test-coverage-include=\"apps/board/*.js\" --test-coverage-exclude=\"apps/board/*.test.js\" --test-coverage-exclude=\"apps/board/*.config.js\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"apps/board/*.test.js\""
        }
      },
      "test": {
        "dependsOn": [
          "test-server"
        ]
      }
    }
  }
}
