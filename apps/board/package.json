{
  "name": "@maggie/board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@linktogo/maggie-ci-status": "^1.1.0",
    "@linktogo/maggie-config": "^1.1.0",
    "@linktogo/maggie-workspace-bootstrap": "^1.1.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "~4.1.0"
  },
  "nx": {
    "tags": [
      "scope:board",
      "type:app"
    ],
    "targets": {
      "start": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/board/server.js"
        }
      },
      "test-server": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test apps/board/server.test.js"
        }
      },
      "test-reader": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test apps/board/ciReader.test.js"
        }
      },
      "test": {
        "dependsOn": [
          "test-server",
          "test-reader"
        ]
      }
    }
  }
}
