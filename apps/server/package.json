{
  "name": "@lk/maggie-server",
  "version": "2.0.0",
  "description": "The maggie server: launches local Claude Code / Copilot agents for the board (AI Factory).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linktogo/maggie.git"
  },
  "homepage": "https://github.com/linktogo/maggie#readme",
  "bugs": {
    "url": "https://github.com/linktogo/maggie/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/main.js",
  "exports": {
    ".": "./src/main.js",
    "./warnings": "./src/warnings.js"
  },
  "bin": {
    "maggie-server": "./bin/server.js"
  },
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "scripts": {
    "prepack": "node ../../scripts/stage-skills.js .",
    "postpack": "node ../../scripts/stage-skills.js . --clean"
  },
  "dependencies": {
    "@lk/maggie-agent-runner": "^2.0.0",
    "@lk/maggie-config": "^2.0.0"
  }
}
