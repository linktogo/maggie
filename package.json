{
  "name": "maggie",
  "version": "1.4.0",
  "description": "Sync AI agent skills, practices, and workflows across repositories — author once, render for Claude Code, GitHub Copilot, Cursor, and Windsurf.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linktogo/maggie.git"
  },
  "homepage": "https://github.com/linktogo/maggie#readme",
  "bugs": {
    "url": "https://github.com/linktogo/maggie/issues"
  },
  "keywords": [
    "maggie",
    "ai-agents",
    "claude-code",
    "github-copilot",
    "cursor",
    "windsurf",
    "monorepo",
    "developer-tools"
  ],
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:scripts": "node --test scripts/*.test.js",
    "check:coverage": "node scripts/check-coverage-gates.js",
    "retro-doc": "node scripts/retro-doc.js",
    "build": "nx run-many -t build",
    "start": "node apps/board/bin/maggie.js --config-repo https://github.com/linktogo-org/lk-config.git",
    "sync": "node apps/board/bin/maggie.js sync",
    "wk": "node apps/board/bin/maggie.js workspace --workspace wk",
    "board:build": "nx run board:build",
    "test:board": "nx run board:test",
    "publish:libs": "pnpm -r publish --no-git-checks",
    "publish:verdaccio": "pnpm -r publish --no-git-checks --registry http://localhost:4873",
    "prepare": "node scripts/install-git-hooks.js",
    "board": "node apps/board/bin/maggie.js --board",
    "server": "node apps/board/bin/maggie.js --server --config-repo https://github.com/linktogo-org/lk-config.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lk/maggie-retro-doc": "^1.3.1",
    "@nx/eslint": "^24.0.4",
    "@nx/eslint-plugin": "^24.0.4",
    "@nx/js": "^24.0.4",
    "@nx/vite": "^24.0.4",
    "@nx/vitest": "^24.0.4",
    "@nx/vue": "^24.0.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^31.0.0",
    "nx": "^24.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "~5.1.0"
  },
  "private": true
}
